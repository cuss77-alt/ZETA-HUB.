                RGBBtn.Text = "Wallhack RGB: OFF"
                RGBBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
            end
        end)

        RGBBtn.MouseButton1Click:Connect(function()
            if not WallhackEnabled then
                game.StarterGui:SetCore("SendNotification", {
                    Title = "⚠️ ADVERTENCIA",
                    Text = "¡Activa el Wallhack primero antes de usar RGB!\nEnable Wallhack first!",
                    Duration = 4
                })
            else
                WallhackRGBEnabled = not WallhackRGBEnabled
                RGBBtn.Text = WallhackRGBEnabled and "Wallhack RGB: ON" or "Wallhack RGB: OFF"
                RGBBtn.TextColor3 = WallhackRGBEnabled and Color3.fromRGB(0, 230, 118) or Color3.fromRGB(255, 90, 90)
            end
        end)

        -- --- FASE DISCORD ---
        local DiscordInfo = Instance.new("TextLabel", DiscordContainer)
        DiscordInfo.BackgroundTransparency = 1
        DiscordInfo.Position = UDim2.new(0, 0, 0.05, 0)
        DiscordInfo.Size = UDim2.new(1, 0, 0, 70)
        DiscordInfo.Font = Enum.Font.GothamBold
        DiscordInfo.Text = "¡Comunidad oficial de Zeta Hub!\nDiscord: discord.gg/NWkDhcG2p"
        DiscordInfo.TextColor3 = Color3.fromRGB(210, 210, 210)
        DiscordInfo.TextSize = 12

        local CopyDiscordBtn = Instance.new("TextButton", DiscordContainer)
        CopyDiscordBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        CopyDiscordBtn.Position = UDim2.new(0, 0, 0.50, 0)
        CopyDiscordBtn.Size = UDim2.new(1, 0, 0, 38)
        CopyDiscordBtn.Font = Enum.Font.GothamBold
        CopyDiscordBtn.Text = "Copiar Link de Discord"
        CopyDiscordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        CopyDiscordBtn.TextSize = 12
        Instance.new("UICorner", CopyDiscordBtn).CornerRadius = UDim.new(0, 6)

        CopyDiscordBtn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard("discord.gg/NWkDhcG2p")
                CopyDiscordBtn.Text = "¡Copiado al portapapeles!"
                task.wait(2)
                CopyDiscordBtn.Text = "Copiar Link de Discord"
            end
        end)

        -- Círculo FOV visual & Motor de Aimbot & Wallhacks
        local FOVCircle = Drawing.new("Circle")
        FOVCircle.Visible = true
        FOVCircle.Transparency = 0.6
        FOVCircle.Color = Color3.fromRGB(0, 230, 118)
        FOVCircle.Thickness = 2
        FOVCircle.Radius = FOVRadius
        FOVCircle.Filled = false

        local rgbHue = 0
        RunService.RenderStepped:Connect(function()
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Radius = FOVRadius
            FOVCircle.Visible = ShowFOV

            if WallhackRGBEnabled then
                rgbHue = (rgbHue + 0.01) % 1
            end
            local currentChamsColor = WallhackRGBEnabled and Color3.fromHSV(rgbHue, 1, 1) or Color3.fromRGB(0, 230, 118)

            if AimbotEnabled then
                local closestPlayer = nil
                local shortestDistance = FOVRadius

                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                        
                        local isTeamMate = false
                        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                            isTeamMate = true
                        end

                        if not isTeamMate then
                            local hrp = player.Character.HumanoidRootPart
                            local screenPoint, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                            
                            if onScreen then
                                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude

                                if distance < shortestDistance and (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 165 then
                                    shortestDistance = distance
                                    closestPlayer = player
                                end
                            end
                        end
                    end
                end

                if closestPlayer and closestPlayer.Character:FindFirstChild("Head") then
                    local targetCFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.Head.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.25)
                end
            end

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    if WallhackEnabled then
                        if not char:FindFirstChild("ZetaHighlight") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "ZetaHighlight"
                            hl.Adornee = char
                            hl.FillColor = currentChamsColor
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.Parent = char
                        else
                            char.ZetaHighlight.FillColor = currentChamsColor
                        end
                    else
                        if char:FindFirstChild("ZetaHighlight") then
                            char.ZetaHighlight:Destroy()
                        end
                    end
                end
            end
        end)

        task.delay(60, function()
            game.StarterGui:SetCore("SendNotification", {
                Title = "⚠️ ADVERTENCIA / WARNING",
                Text = "Usa el script con cuidado para evitar bans. No abuses.\nUse carefully to avoid bans.",
                Duration = 8
            })
        end)

    else
        VerifyBtn.Text = "¡Key Incorrecta / Wrong Key!"
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        task.wait(1.5)
        VerifyBtn.Text = "VERIFICAR KEY"
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end
end)
